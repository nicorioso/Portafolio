<section id="inicio" class="hero-section section-anchor">
    <div class="container hero-inner">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 order-2 order-lg-1">
                <p class="eyebrow mb-3"><span class="status-dot"></span> @PortfolioData.HeroStatus</p>
                <h1 class="hero-title">Hola, soy <span class="text-accent">Nicolas Rios Osorio</span></h1>
                <p class="hero-role">@PortfolioData.HeroRole</p>
                <p class="hero-copy">@PortfolioData.HeroIntro</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-primary btn-lg" href="#proyectos">Ver proyectos <i class="bi bi-arrow-down-right ms-1" aria-hidden="true"></i></a>
                    <a class="btn btn-outline-light btn-lg" href="#contacto">Contacto</a>
                </div>
                <div class="d-flex gap-3 mt-4 social-links">
                    @foreach (var social in PortfolioData.SocialLinks)
                    {
                        <a href="@social.Url" target="_blank" rel="noopener noreferrer" aria-label="Abrir @social.Label en una pestaña nueva"><i class="bi @social.Icon" aria-hidden="true"></i> @social.Label</a>
                    }
                </div>
            </div>
            <div class="col-lg-5 order-1 order-lg-2 d-flex justify-content-center">
                <div class="hero-photo" role="img" aria-label="Espacio reservado para una foto de Nicolas Rios Osorio"><span>NR</span><small>Foto próximamente</small></div>
            </div>
        </div>
    </div>
</section>
