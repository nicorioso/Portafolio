<section id="experiencia" class="section-block section-anchor reveal-section">
    <div class="container content-narrow">
        <SectionTitle Eyebrow="@PortfolioData.ExperienceEyebrow" Title="@PortfolioData.ExperienceTitle" />
        <div class="timeline">
            @foreach (var item in PortfolioData.Experience)
            {
                <article class="timeline-item">
                    <span class="timeline-dot" aria-hidden="true"></span>
                    <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start"><div><h3>@item.Role</h3><p class="text-accent mb-1">@item.Organization</p></div><span class="period-badge">@item.Period</span></div>
                    <p class="text-secondary mt-3">@item.Summary</p>
                    <ul class="experience-details">@foreach (var detail in item.Details) { <li>@detail</li> }</ul>
                    <div class="d-flex flex-wrap gap-2 mt-3">@foreach (var technology in item.Technologies) { <span class="tech-badge">@technology</span> }</div>
                </article>
            }
        </div>
    </div>
</section>
