<section id="contacto" class="section-block section-anchor reveal-section surface-section">
    <div class="container content-narrow">
        <SectionTitle Eyebrow="@PortfolioData.ContactEyebrow" Title="@PortfolioData.ContactTitle" Subtitle="@PortfolioData.ContactSubtitle" />
        <div class="contact-card">
            <a class="contact-item" href="mailto:@PortfolioData.Email"><span class="contact-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span><span><small>Correo</small><strong>@PortfolioData.Email</strong></span><i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i></a>
            <a class="contact-item" href="@PortfolioData.LinkedIn" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><i class="bi bi-linkedin" aria-hidden="true"></i></span><span><small>LinkedIn</small><strong>Conectemos</strong></span><i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i></a>
            <a class="contact-item" href="@PortfolioData.GitHub" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><i class="bi bi-github" aria-hidden="true"></i></span><span><small>GitHub</small><strong>nicorioso</strong></span><i class="bi bi-arrow-up-right ms-auto" aria-hidden="true"></i></a>
            <div class="contact-item"><span class="contact-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span><span><small>Ubicación</small><strong>@PortfolioData.City</strong></span></div>
        </div>
        <a class="btn btn-primary mt-4" href="mailto:@PortfolioData.Email"><i class="bi bi-send me-2" aria-hidden="true"></i>Escríbeme</a>
    </div>
</section>
