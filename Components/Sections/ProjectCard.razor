<article class="project-card h-100">
    <div class="project-image" role="img" aria-label="@(Project.ImageAlt.Length > 0 ? Project.ImageAlt : $"Captura pendiente del proyecto {Project.Title}")">
        @if (Project.ImageUrl is not null) { <img src="@Project.ImageUrl" alt="@Project.ImageAlt" loading="lazy" /> }
        else { <i class="bi bi-window-stack" aria-hidden="true"></i><span>Captura del proyecto</span> }
    </div>
    <div class="project-body">
        <div class="d-flex justify-content-between align-items-start gap-2"><h3>@Project.Title</h3>@if (!string.IsNullOrWhiteSpace(Project.Year)) { <span class="project-year">@Project.Year</span> }</div>
        <p class="text-secondary">@Project.Description</p>
        <div class="d-flex flex-wrap gap-2 mb-4">@foreach (var technology in Project.Technologies) { <span class="tech-badge">@technology</span> }</div>
        <div class="d-flex gap-3 mt-auto"><a class="project-link" href="@Project.RepositoryUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-github" aria-hidden="true"></i> Código</a>
            @if (!string.IsNullOrWhiteSpace(Project.DemoUrl)) { <a class="project-link" href="@Project.DemoUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Demo</a> }
        </div>
    </div>
</article>

@code { [Parameter, EditorRequired] public Project Project { get; set; } = default!; }
